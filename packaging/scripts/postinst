#!/bin/sh
# deb postinst and rpm %post: apply the udev rule to devices already plugged in,
# so a USB receiver connected before installation gets access without a replug.
set -e
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=hidraw --action=change || true
fi
exit 0
