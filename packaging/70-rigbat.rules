# udev rule granting the logged-in user read/write access to the USB HID devices
# rigbat supports, via systemd-logind's per-seat ACL mechanism (TAG+="uaccess").
#
# One line is needed per supported device. When adding a model to a hidraw
# backend's FAMILY table (see CONTRIBUTING.md), add the matching
# ATTRS{idVendor}/ATTRS{idProduct} line here too; cargo test fails until they agree.
#
# Filename note: this file must sort lexically *before*
# /usr/lib/udev/rules.d/73-seat-late.rules — that file runs the builtin which
# actually applies the ACL for devices tagged "uaccess", and udev processes
# all rules files in one lexically-sorted sequence regardless of directory.
# A rule numbered 73 or higher would add the tag too late to take effect.
# Hence "70-", not "99-".
#
# Bluetooth and sysfs (kernel power_supply) devices need no rule here — only
# USB HID (hidraw) access is gated by permissions.

# SteelSeries Aerox 5 Wireless (vendor 0x1038, product 0x1852)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="1852", TAG+="uaccess"

# 8BitDo Ultimate 2 Wireless in DInput mode (vendor 0x2dc8, product 0x6012)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="6012", TAG+="uaccess"

# Wireless headsets, see docs/headsets.md

# SteelSeries Arctis 1 Wireless (vendor 0x1038)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="12b3", TAG+="uaccess"

# SteelSeries Arctis 1 Wireless Xbox (vendor 0x1038)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="12b6", TAG+="uaccess"

