# systemd user service for the rigbat tray daemon.
#
# Install: make service && make enable    (see the Makefile / README)
# Logs:    journalctl --user -u rigbat -f
#
# This is a *user* service: the tray needs the graphical session and the
# session D-Bus bus. Your desktop environment must import the session
# environment (WAYLAND_DISPLAY/DISPLAY, DBUS_SESSION_BUS_ADDRESS) into the
# systemd user manager at login — modern systemd desktops (GNOME, KDE,
# COSMIC) do this automatically.
#
# Do not run this service together with the settings "Startup" toggle
# (~/.config/autostart/rigbat.desktop): both launch `rigbat tray` and you
# would get two instances. Pick one.

[Unit]
Description=rigbat — battery tray for gaming peripherals
Documentation=https://github.com/Skesov/rigbat
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Installed by `cargo install --path .`. This default assumes CARGO_HOME is
# ~/.cargo; `make service` rewrites the line to the path cargo actually used,
# so a non-default CARGO_HOME does not produce a unit that fails with 203/EXEC.
ExecStart=%h/.cargo/bin/rigbat tray
Restart=on-failure
RestartSec=2
# Uncomment to raise log verbosity (see journalctl --user -u rigbat -f).
#Environment=RIGBAT_LOG=debug

# --- Hardening -------------------------------------------------------------
# The daemon needs: /dev/hidraw* (SteelSeries HID), the session AND system
# D-Bus buses (BlueZ is on the system bus), ~/.config/rigbat (read/write) and
# ~/.config/autostart (write, via the settings toggle), and the ability to
# spawn `rigbat settings` as a GUI child with access to the Wayland/X11
# socket and the GPU. Directives that would break any of that (PrivateDevices,
# ProtectHome, MemoryDenyWriteExecute, PrivateNetwork, ProtectSystem=strict)
# are deliberately omitted.

# Blocks privilege escalation via setuid/setgid/file capabilities. Does not
# touch device, D-Bus, or GUI access.
NoNewPrivileges=true
# Gives the process a private /tmp; rigbat only writes under ~/.config, so
# this affects nothing rigbat uses.
PrivateTmp=true
# Read-only /usr, /boot, /efi, /etc. `full` (not `strict`) so it does not
# touch /home, /run, or /dev — /run holds the Wayland/D-Bus sockets and /dev
# holds hidraw, both required.
ProtectSystem=full
# Blocks writes to /proc/sys, /sys, etc. rigbat never tunes kernel state.
ProtectKernelTunables=true
# Blocks access to the kernel log ring buffer (/dev/kmsg, /proc/kmsg).
ProtectKernelLogs=true
# Makes /sys/fs/cgroup read-only. rigbat does not manage cgroups.
ProtectControlGroups=true
# Blocks writes to the hardware/system clock. rigbat never sets the time.
ProtectClock=true
# Blocks acquiring realtime scheduling (SCHED_FIFO/RR/DEADLINE).
RestrictRealtime=true
# Blocks creating SUID/SGID files. rigbat never does.
RestrictSUIDSGID=true
# Blocks creating new Linux namespaces from within the unit's processes.
# Does not affect the D-Bus session/system bus (AF_UNIX, not a namespace).
RestrictNamespaces=true
# Locks the process personality (execution domain). No legitimate use here.
LockPersonality=true
# Tightens permissions on files rigbat creates (~/.config/rigbat/config.json)
# to owner-only instead of the inherited 0022.
UMask=0077
# rigbat never opens an AF_INET/AF_INET6 socket (all sources are HID/sysfs/
# D-Bus); deny all IP traffic. Does not affect AF_UNIX (D-Bus, Wayland/X11).
IPAddressDeny=any
# Rejects non-native syscall ABIs (e.g. 32-bit compat) on this native amd64
# binary. Does not remove or filter any specific syscall by name.
SystemCallArchitectures=native
# Restricts the unit to the syscalls a normal userspace service needs. The
# settings window is spawned as a child of the tray and inherits this filter,
# so the GPU path is the thing that had to be proven: verified under
# `systemd-run --user -p SystemCallFilter=@system-service` that the window
# starts, holds /dev/dri/renderD128 open and renders, and that the tray opens
# and writes /dev/hidraw and publishes its SNI item — no SIGSYS on either.
# EPERM rather than the default SIGSYS: a denied syscall should surface as an
# error the program can report, not kill the tray outright.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
